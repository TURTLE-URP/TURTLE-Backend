  menu_item_id                                                  Int                     @id(map: "menu_items_pk") @default(autoincrement())
  name                                                          String                  @db.VarChar
  description                                                   String                  @db.VarChar
  unit_price                                                    Decimal                 @default(0.00) @db.Decimal(10, 2)
  status                                                        menu_item_status_type
  type                                                          menu_item_type
  combo_description_combo_description_combo_item_idTomenu_items combo_description[]     @relation("combo_description_combo_item_idTomenu_items")
  combo_description_combo_description_menu_item_idTomenu_items  combo_description[]     @relation("combo_description_menu_item_idTomenu_items")
  customer_order_items                                          customer_order_items[]
  menu_item_ingredients                                         menu_item_ingredients[]
  menu_item_tagging                                             menu_item_tagging[]
