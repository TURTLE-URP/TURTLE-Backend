  supply_orders          supply_orders          @relation(fields: [supply_order_id], references: [supply_order_id], onDelete: Cascade, onUpdate: NoAction, map: "supply_order_contents_supply_orders_fk")
  supplier_catalog_items supplier_catalog_items @relation(fields: [supplier_catalog_item_id], references: [supplier_catalog_item_id], onDelete: Restrict, onUpdate: NoAction, map: "supply_order_contents_supplier_catalog_items_fk")
