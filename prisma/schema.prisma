enum contact_method_type {
  email
  phone
  WhatsApp
}

enum customer_order_item_status_type {
  pending
  preparing
  finished
}

enum customer_order_payment_status_type {
  pending
  paid
}

enum customer_order_status_type {
  pending
  preparing
  on_the_way @map("on the way")
  delivered
}

enum customer_order_type {
  dine_in  @map("dine in")
  take_out @map("take out")
  delivery
}

enum menu_item_status_type {
  available
  out_of_stock @map("out of stock")
  discontinued
}

enum menu_item_type {
  combo
  item
}

enum restaurant_table_status_type {
  available
  occupied
}

enum supply_order_modality_type {
  por_escasez   @map("Por escasez")
  por_platillos @map("Por platillos")
  abasto_libre  @map("Abasto libre")
}

enum supply_order_status_type {
  pendiente @map("Pendiente")
  acordada  @map("Acordada")
  entregada @map("Entregada")
  error     @map("Error")
}

enum kitchen_movement_status {
  pending
  preparing
  ready
  delivered
}

model comanda {
  comanda_id        Int      @id @default(autoincrement())
  code              String   @db.VarChar
  ready             Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)
  customer_order_id Int
  customer_order    customer_order @relation(fields: [customer_order_id], references: [customer_order_id], onDelete: Cascade, onUpdate: NoAction, map: "comanda_customer_order_fk")
  comanda_items     comanda_items[]
}

model comanda_items {
  comanda_item_id   Int      @id @default(autoincrement())
  quantity          Int      @db.SmallInt
  notes             String?  @db.VarChar
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)
  comanda_id        Int
  menu_item_id      Int
  comanda           comanda @relation(fields: [comanda_id], references: [comanda_id], onDelete: Cascade, onUpdate: NoAction, map: "comanda_items_comanda_fk")
  menu_items        menu_items @relation(fields: [menu_item_id], references: [menu_item_id], onUpdate: NoAction, map: "comanda_items_menu_items_fk")
  kitchen_movements kitchen_movements[]
}

model kitchen_movements {
  kitchen_movement_id Int      @id @default(autoincrement())
  timestamp           DateTime @default(now()) @db.Timestamp(6)
  status              kitchen_movement_status
  quantity            Int      @db.SmallInt
  created_at          DateTime @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @db.Timestamp(6)
  comanda_item_id     Int
  comanda_items       comanda_items @relation(fields: [comanda_item_id], references: [comanda_item_id], onDelete: Cascade, onUpdate: NoAction, map: "kitchen_movements_comanda_items_fk")
}

enum payment_method_type {
  cash
  credit_card
  debit_card
  yape
  plin
  transfer
}

model payment {
  payment_id         Int                  @id @default(autoincrement())
  code               String               @db.VarChar(10)
  payment_method     payment_method_type
  amount             Decimal              @db.Decimal(10, 2)
  receipt_url        String?              @db.Text
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @db.Timestamp(6)
  customer_order_id  Int
  customer_order     customer_order       @relation(fields: [customer_order_id], references: [customer_order_id], onDelete: Cascade, onUpdate: NoAction, map: "payment_customer_order_fk")
  payment_details    payment_details[]
}

model payment_details {
  payment_detail_id  Int      @id @default(autoincrement())
  quantity           Int      @db.SmallInt
  subtotal           Decimal  @db.Decimal(10, 2)
  tax                Decimal  @db.Decimal(10, 2)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @db.Timestamp(6)
  payment_id         Int
  menu_item_id       Int
  payment            payment  @relation(fields: [payment_id], references: [payment_id], onDelete: Cascade, onUpdate: NoAction, map: "payment_details_payment_fk")
  menu_items         menu_items @relation(fields: [menu_item_id], references: [menu_item_id], onUpdate: NoAction, map: "payment_details_menu_items_fk")
}

enum auth_provider_type {
  google
  facebook
  apple
  email
}

model digital_customer {
  digital_customer_id Int               @id @default(autoincrement())
  full_name           String            @db.VarChar
  auth_provider       auth_provider_type
  provider_user_id    String            @db.VarChar
  created_at          DateTime          @default(now()) @db.Timestamp(6)
  updated_at          DateTime?         @db.Timestamp(6)
  customer_order      customer_order[]
}

enum user_type {
  admin
  cashier
  waiter
  kitchen
}

model user {
  user_id      Int            @id @default(autoincrement())
  email        String         @unique @db.VarChar
  user_type    user_type
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime?      @db.Timestamp(6)
  deleted_at   DateTime?      @db.Timestamp(6)
  system_audit system_audit[]
}

enum worker_role_type {
  admin
  cashier
  waiter
  kitchen
}

model worker {
  worker_id     Int               @id @default(autoincrement())
  name          String            @db.VarChar
  last_name     String            @db.VarChar
  password_hash String            @db.VarChar
  role          worker_role_type
  created_at    DateTime          @default(now()) @db.Timestamp(6)
  updated_at    DateTime?         @db.Timestamp(6)
}

enum audit_action_type {
  create
  read
  update
  soft_delete
  restore
}

model system_audit {
  system_audit_id Int               @id @default(autoincrement())
  user_id         Int
  action          audit_action_type
  affected_table  String            @db.VarChar
  row_id          String            @db.VarChar
  ip_address      String            @db.VarChar
  user_agent      String            @db.Text
  timestamp       DateTime          @default(now()) @db.Timestamp(6)
  user            user              @relation(fields: [user_id], references: [user_id], onDelete: Restrict, onUpdate: NoAction, map: "system_audit_user_fk")
}
